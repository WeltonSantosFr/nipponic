// use prisma-next

model User {
  id             String   @id @default(uuid())
  username       String   @unique
  email          String   @unique
  password       String
  githubUsername String?  @unique
  
  notes          Note[]
  cards          Card[]
  decks          Deck[]
  sponsorships   Sponsor[]
  lessonProgress UserLessonProgress[]
  
  createdAt      DateTime @default(now())
  updatedAt      temporal.updatedAt()
}

model Note {
  id         String   @id @default(uuid())
  title      String
  enText     String
  jpText     String
  sourceLang String   @default("EN")
  
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  createdAt  DateTime @default(now())
  updatedAt  temporal.updatedAt()
}

model Card {
  id             String    @id @default(uuid())
  jpText         String
  enText         String
  interval       Int       @default(0)
  easeFactor     Float     @default(2.5)
  repetitions    Int       @default(0)
  lapses         Int       @default(0)
  nextReviewAt   DateTime?
  lastReviewedAt DateTime?
  
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  deckCards      DeckCard[]
  
  createdAt      DateTime  @default(now())
  updatedAt      temporal.updatedAt()
}

model Deck {
  id        String   @id @default(uuid())
  name      String
  isPublic  Boolean  @default(false)
  
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  deckCards DeckCard[]
  
  createdAt DateTime @default(now())
  updatedAt temporal.updatedAt()
}

model DeckCard {
  id        String   @id @default(uuid())
  order     Int      @default(0)
  
  deckId    String
  deck      Deck     @relation(fields: [deckId], references: [id], onDelete: Cascade)
  
  cardId    String
  card      Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  
  createdAt DateTime @default(now())
}

model Sponsor {
  id                  String   @id @default(uuid())
  githubUsername      String   @unique
  githubUserId        String?
  avatarUrl           String?
  name                String?
  tierName            String
  monthlyPriceInCents Int      @default(0)
  isOneTime           Boolean  @default(false)
  isActive            Boolean  @default(true)
  
  userId              String?
  user                User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  
  createdAt           DateTime @default(now())
  updatedAt           temporal.updatedAt()
}

model CurriculumTopic {
  id          String   @id @default(uuid())
  level       String
  unitIndex   Int
  unitTitle   String
  lessonIndex Int
  title       String
  grammarKey  String
  objective   String

  lesson      Lesson?

  createdAt   DateTime @default(now())
  updatedAt   temporal.updatedAt()

  @@unique([level, unitIndex, lessonIndex])
}

model Lesson {
  id             String          @id @default(uuid())
  topicId        String          @unique
  topic          CurriculumTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  
  title          String
  level          String          @default("N5")
  theoryMarkdown String
  dialogueJson   Json
  vocabularyJson Json
  
  exercises      LessonExercise[]
  progress       UserLessonProgress[]
  feedbacks      LessonFeedback[]
  
  createdAt      DateTime        @default(now())
  updatedAt      temporal.updatedAt()
}

model LessonExercise {
  id            String   @id @default(uuid())
  lessonId      String
  lesson        Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  
  order         Int
  type          String
  prompt        String
  optionsJson   Json?
  correctAnswer String
  explanation   String

  createdAt     DateTime @default(now())
}

model UserLessonProgress {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId    String
  lesson      Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  
  completedAt DateTime?
  score       Int       @default(0)
  
  createdAt   DateTime  @default(now())
  updatedAt   temporal.updatedAt()

  @@unique([userId, lessonId])
}

model LessonFeedback {
  id        String   @id @default(uuid())
  lessonId  String
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  userId    String?
  rating    String
  comment   String?
  createdAt DateTime @default(now())
}